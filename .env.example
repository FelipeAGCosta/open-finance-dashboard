# Copie para .env (fora do Git) e preencha. Passo a passo: docs/pluggy-setup.md
# Para só ver o painel, não precisa de nada disto: rode `findash demo`.

# Credenciais da aplicação no dashboard da Pluggy
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Um ou mais itens (bancos conectados), separados por vírgula.
# Opcional: ":perfil" escolhe o perfil de instituição (hoje: nubank). Sem sufixo, vale o genérico.
# Exemplo: PLUGGY_ITEM_IDS=11111111-1111-1111-1111-111111111111:nubank,22222222-2222-2222-2222-222222222222
PLUGGY_ITEM_IDS=
